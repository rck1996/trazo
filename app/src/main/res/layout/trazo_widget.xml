<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_paper"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent"
        android:layout_height="38dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/widget_header_art" android:layout_width="38dp" android:layout_height="38dp"
            android:contentDescription="@null" android:scaleType="centerInside"
            android:src="@drawable/widget_ai_tomato" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="7dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_date" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="cursive"
                android:maxLines="1" android:text="Domingo 16 de agosto" android:textColor="#272522"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_date_minimal" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
                android:text="Domingo 16 de agosto" android:textColor="#000000"
                android:textSize="16sp" android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/widget_greeting" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
                android:text="Tu día, de un vistazo" android:textColor="#716B63" android:textSize="10sp" />
        </LinearLayout>
        <TextView android:id="@+id/widget_progress_percent" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:fontFamily="cursive" android:text="50%"
            android:textColor="#4F9273" android:textSize="19sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_rhythm" android:layout_width="match_parent" android:layout_height="34dp"
        android:layout_marginTop="6dp" android:background="@drawable/widget_rhythm"
        android:gravity="center_vertical" android:orientation="vertical"
        android:paddingHorizontal="10dp" android:paddingVertical="5dp">
        <TextView android:id="@+id/widget_progress" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
            android:text="2 pendientes  ·  1/3 rituales" android:textColor="#514D48"
            android:textSize="10sp" android:textStyle="bold" />
        <ProgressBar android:id="@+id/widget_day_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="3dp"
            android:max="100" android:progress="50" android:progressBackgroundTint="#26A5A099"
            android:progressTint="#F06C4F" />
    </LinearLayout>

    <TextView android:id="@+id/widget_task_label" android:layout_width="match_parent" android:layout_height="18dp"
        android:layout_marginTop="6dp" android:background="@drawable/widget_task_section_label"
        android:gravity="center_vertical" android:paddingHorizontal="9dp"
        android:text="TAREAS  ·  DESLIZA ↕" android:textColor="#D8573E"
        android:textSize="8sp" android:textStyle="bold" />

    <FrameLayout android:id="@+id/widget_task_region" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="3dp" android:layout_weight="1"
        android:minHeight="62dp">
        <ListView android:id="@+id/widget_task_stack" android:layout_width="match_parent"
            android:layout_height="match_parent" android:contentDescription="Tareas pendientes, desliza verticalmente"
            android:divider="@null" android:dividerHeight="0dp" android:fadingEdge="vertical"
            android:fadingEdgeLength="12dp"
            android:scrollbars="none" />
        <LinearLayout android:id="@+id/widget_task_empty" android:layout_width="match_parent"
            android:layout_height="match_parent" android:background="@drawable/widget_note"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingHorizontal="9dp" android:paddingVertical="5dp">
            <ImageView android:id="@+id/widget_task_empty_art" android:layout_width="44dp" android:layout_height="44dp"
                android:contentDescription="@null" android:scaleType="centerInside"
                android:src="@drawable/widget_ai_task" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="7dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_task_empty_eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ESPACIO LIBRE" android:textColor="#F06C4F" android:textSize="9sp"
                    android:textStyle="bold" />
                <TextView android:id="@+id/widget_task_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="No hay tareas pendientes" android:textColor="#272522"
                    android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/widget_task_empty_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Toca aquí para abrir tu lista" android:textColor="#716B63"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView android:id="@+id/widget_habit_label" android:layout_width="match_parent" android:layout_height="18dp"
        android:layout_marginTop="6dp" android:background="@drawable/widget_habit_section_label"
        android:gravity="center_vertical" android:paddingHorizontal="9dp"
        android:text="HÁBITOS  ·  DESLIZA ↕" android:textColor="#34765B"
        android:textSize="8sp" android:textStyle="bold" />

    <FrameLayout android:id="@+id/widget_habit_region" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="3dp" android:layout_weight="1"
        android:minHeight="54dp">
        <ListView android:id="@+id/widget_habit_stack" android:layout_width="match_parent"
            android:layout_height="match_parent" android:contentDescription="Hábitos de hoy, desliza verticalmente"
            android:divider="@null" android:dividerHeight="0dp" android:fadingEdge="vertical"
            android:fadingEdgeLength="12dp"
            android:scrollbars="none" />
        <LinearLayout android:id="@+id/widget_habit_empty" android:layout_width="match_parent"
            android:layout_height="match_parent" android:background="@drawable/widget_habit_note"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingHorizontal="9dp" android:paddingVertical="5dp">
            <ImageView android:id="@+id/widget_habit_empty_art" android:layout_width="39dp" android:layout_height="39dp"
                android:contentDescription="@null" android:scaleType="centerInside"
                android:src="@drawable/widget_ai_ritual" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_habit_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Hoy no hay rituales" android:textColor="#272522" android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView android:id="@+id/widget_habit_empty_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="EL JARDÍN DESCANSA ✦" android:textColor="#43866A"
                    android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
        android:layout_marginTop="7dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_planner" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_button"
            android:gravity="center" android:text="▦  Planner" android:textColor="#272522"
            android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_focus_action" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_marginStart="4dp" android:layout_weight="1.35" android:background="@drawable/widget_button_coral"
            android:gravity="center" android:text="🍅  Iniciar 25 min" android:textColor="#FFFFFF"
            android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
