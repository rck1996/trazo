<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_item"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:background="@drawable/widget_note"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="9dp"
    android:paddingVertical="5dp">

    <ImageView android:id="@+id/widget_task_item_image" android:layout_width="44dp"
        android:layout_height="44dp" android:contentDescription="Abrir tareas"
        android:scaleType="centerInside" android:src="@drawable/widget_ai_task" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="7dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/widget_task_item_mark" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#F06C4F"
            android:textSize="9sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_task_item_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
            android:textColor="#272522" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_task_item_meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
            android:textColor="#716B63" android:textSize="9sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_task_item_complete" android:layout_width="38dp"
        android:layout_height="38dp" android:layout_marginStart="7dp"
        android:background="@drawable/widget_check" android:contentDescription="Completar tarea"
        android:gravity="center" android:text="✓" android:textColor="#FFFFFF"
        android:textSize="19sp" android:textStyle="bold" />
</LinearLayout>
