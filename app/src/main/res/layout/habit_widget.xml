<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habit_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_paper"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/habit_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_today_ritual"
            android:textColor="#43866A"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/habit_widget_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_habit_progress_preview"
            android:textColor="#6F6961"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/habit_widget_emoji"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="@string/widget_spark"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/habit_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_habit_preview"
        android:textColor="#272522"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/habit_widget_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_start_streak"
            android:textColor="#6F6961"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/habit_widget_check"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_check"
            android:contentDescription="@string/widget_complete_habit"
            android:gravity="center"
            android:text="@string/widget_check"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
