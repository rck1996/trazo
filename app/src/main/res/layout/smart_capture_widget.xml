<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/smart_capture_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_paper"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="13dp">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_tomato" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/smart_capture_widget_title"
            android:textColor="#272522"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/smart_capture_widget_example"
            android:textColor="#6F6961"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/smart_capture_voice"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_button_coral"
        android:contentDescription="@string/smart_capture_widget_voice"
        android:gravity="center"
        android:text="●"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />
</LinearLayout>
